# Application settings
APP_NAME=AI Toolbox Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here-at-least-32-characters

# API Settings
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=localhost,127.0.0.1,10.148.218.115
CORS_ORIGINS=["chrome-extension://*", "http://localhost:3000"]

# Azure AI Settings
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-if-using-key-auth
AZURE_OPENAI_API_VERSION=2023-05-15
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o


# Database Settings
DATABASE_URL=postgresql+asyncpg://localhost/ai_toolbox
DATABASE_ECHO=false

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-here-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Feature Switches
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_METRICS=true

# Microsoft OAuth Configuration (Recommended, more secure)
MS_OAUTH_CLIENT_ID=your-azure-app-client-id
MS_OAUTH_CLIENT_SECRET=your-azure-app-client-secret
MS_OAUTH_GRANT_TYPE=client_credentials
MS_OAUTH_SCOPE=https://cognitiveservices.azure.com/.default
MS_OAUTH_URL=https://login.microsoftonline.com/your-tenant-id/oauth2/v2.0/token

# Jira API Settings
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_ENABLE_API=false
JIRA_API_TIMEOUT=30
JIRA_DEFAULT_PROJECT=YOUR_PROJECT_KEY

# Jira Authentication Settings (Choose one)
# Method 1: Personal Access Token (PAT) - Recommended for Cloud instances
JIRA_AUTH_METHOD=pat
JIRA_PERSONAL_ACCESS_TOKEN=your-personal-access-token-here

# Method 2: Basic Authentication (Username + API Token) - Suitable for some instances
# JIRA_AUTH_METHOD=basic
# JIRA_USERNAME=your-email@company.com
# JIRA_API_TOKEN=your-jira-api-token 